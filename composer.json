{
    "type": "project",
    "name": "sweetchuck/webide-config-manager",
    "description": "Helper script to store JetBrains IDE configurations in multiple directories.",
    "keywords": [
        "jetbrains",
        "webide",
        "phpstorm"
    ],
    "authors": [
        {
            "name": "Andor",
            "role": "Maintainer",
            "homepage": "https://github.com/Sweetchuck"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/Sweetchuck/WebIdeConfigManager/graphs/contributors"
        }
    ],
    "homepage": "https://github.com/Sweetchuck/WebIdeConfigManager",
    "support": {
        "source": "https://github.com/Sweetchuck/WebIdeConfigManager",
        "issues": "https://github.com/Sweetchuck/WebIdeConfigManager/issues"
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "sweetchuck/git-hooks": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "require": {
        "php": ">=8.4",
        "ext-bz2": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-phar": "*",
        "consolidation/config": "^3.0",
        "consolidation/robo": "^5.0",
        "cweagans/composer-patches": "^2.0",
        "sebastian/diff": "^7.0",
        "sweetchuck/utils": "2.x-dev"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "nette/neon": "^3.4",
        "nuvoleweb/robo-config": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "psalm/phar": "^5.26",
        "squizlabs/php_codesniffer": "^4.0",
        "sweetchuck/git-hooks": "^3.0",
        "sweetchuck/robo-composer": "4.x-dev",
        "sweetchuck/robo-git": "4.x-dev",
        "sweetchuck/robo-phpcs": "4.x-dev",
        "sweetchuck/robo-phpstan": "3.x-dev",
        "symfony/error-handler": "^5.3",
        "symfony/yaml": "^7.1 || ^8.0"
    },
    "suggest": {
        "ext-tidy": "If Tidy is available then it is used for more advanced XML formatting."
    },
    "bin": [
        "./bin/jbcm"
    ],
    "autoload": {
        "psr-4": {
            "Sweetchuck\\WebIdeConfigManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sweetchuck\\WebIdeConfigManager\\Dev\\": "src-dev/",
            "Sweetchuck\\WebIdeConfigManager\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "patches": {
            "consolidation/robo": [
                {
                    "description": "Deprecation warning from Symfony Console",
                    "url": "https://patch-diff.githubusercontent.com/raw/consolidation/robo/pull/1184.patch",
                    "sha256": "e8244b97b34622447c0e49bc1bf2153c16b98a8f6847670e8f2c39760457a60c",
                    "extra": {
                        "issue-tracker-url": "https://github.com/consolidation/robo/issues/1183"
                    }
                }
            ]
        }
    }
}
